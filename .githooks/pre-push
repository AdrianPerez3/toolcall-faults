#!/bin/sh
# A push publishes the repository, and its fixtures and adapters reproduce findings.
# The developer runs it deliberately:  TCF_ALLOW_PUSH=1 git push ...
# Active after: git config core.hooksPath .githooks
if [ "${TCF_ALLOW_PUSH:-}" != "1" ]; then
  echo "pre-push: pushing is an outward step. The developer runs it as: TCF_ALLOW_PUSH=1 git push ..." >&2
  exit 1
fi

# The history before the publication snapshot holds observations of behaviours that were not
# reported upstream when it was written. No ref that contains its first commit may be pushed.
private_root=308bcc6ec21618da589fc98db9230aa5216d74ce
if git cat-file -e "$private_root^{commit}" 2>/dev/null; then
  while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
    if git merge-base --is-ancestor "$private_root" "$local_oid" 2>/dev/null; then
      echo "pre-push: $local_ref contains the private pre-publication history and must not be pushed." >&2
      exit 1
    fi
  done
fi
exit 0
