#!/bin/sh
# A push publishes the repository, and its fixtures and adapters reproduce findings.
# The developer runs it deliberately:  TCF_ALLOW_PUSH=1 git push ...
# Active after: git config core.hooksPath .githooks
if [ "${TCF_ALLOW_PUSH:-}" != "1" ]; then
  echo "pre-push: pushing is an outward step. The developer runs it as: TCF_ALLOW_PUSH=1 git push ..." >&2
  exit 1
fi

# Every published commit must have the reviewed snapshot as its only root.
# Peeling to a commit also checks annotated tags and rejects tags of trees or blobs.
public_root=86ce2e71c3e07b95b72ff24e3c36fe3b03baab30
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_ref" = "(delete)" ] && [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi
  if ! roots=$(GIT_GRAFT_FILE=/dev/null git --no-replace-objects rev-list --max-parents=0 "${local_oid}^{commit}" -- 2>/dev/null) ||
     [ "$roots" != "$public_root" ]; then
    echo "pre-push: $local_ref must descend solely from the reviewed publication snapshot." >&2
    exit 1
  fi
done
